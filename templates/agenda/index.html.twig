{% extends 'base.html.twig' %}

{% block title %}Agenda – {{ parent() }}{% endblock %}

{% block body %}
    <twig:PageTitle title="Agenda" />

    {# Sketch 7: date – show (Teddy's in bright red, Angéline's in burgundy) – place – event. #}
    {% if performances is empty %}
        <p class="placeholder">Les prochaines dates arrivent bientôt.</p>
    {% else %}
        <ul class="agenda">
            {% for performance in performances %}
                <li class="agenda-row">
                    <span class="agenda-row-date">{{ performance.date|format_date(pattern: 'd MMM y') }}</span>
                    <a class="agenda-row-show agenda-row-show--{{ performance.show.member.username|default('') }}"
                        href="{{ path('app_show', {slug: performance.show.slug}) }}">{{ performance.show.title }}</a>
                    <span class="agenda-row-place">{{ performance.place }}</span>
                    {% if performance.event %}
                        <span class="agenda-row-event">{{ performance.event }}</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
