{% extends 'base.html.twig' %}

{% block title %}Compagnie – {{ parent() }}{% endblock %}

{% block body %}
    {# Sketch 2: an image (the logo by default) and the presentation of the company. #}
    <section class="section company-intro">
        {% if company.image %}
            <img src="{{ asset('uploads/compagnie/' ~ company.image) }}" alt="">
        {% else %}
            <img src="{{ asset('images/logo-fdp.webp') }}" alt="" width="1024" height="1024">
        {% endif %}
        <div>
            <h1 class="sr-only">La compagnie</h1>
            {% for paragraph in company.presentation|paragraphs %}
                <p>{{ paragraph|nl2br }}</p>
            {% endfor %}
        </div>
    </section>

    {# Sketch 3: the members side by side. #}
    {% if members is not empty %}
        <section class="section members">
            {% for member in members %}
                <article class="member">
                    {% if member.photo %}
                        <div class="portrait frame">
                            <img src="{{ asset('uploads/compagnie/' ~ member.photo) }}" alt="{{ member.fullName }}">
                        </div>
                    {% endif %}
                    <h2>{{ member.fullName }}</h2>
                    {% for paragraph in member.bio|paragraphs %}
                        <p>{{ paragraph|nl2br }}</p>
                    {% endfor %}
                    {% set shows = member.shows|filter(show => show.published) %}
                    {% if shows is not empty %}
                        <ul class="member-shows">
                            {% for show in shows %}
                                <li><a class="frame" href="{{ path('app_show', {slug: show.slug}) }}">{{ show.title }}</a></li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </article>
            {% endfor %}
        </section>
    {% endif %}
{% endblock %}
