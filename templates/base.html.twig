<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Fatale Destinée Production{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
        {# Each page overrides the description block, on one line: Google shows it under the title in its results. #}
        <meta name="description" content="{% block description %}Fatale Destinée Production, compagnie de clown et de théâtre de l’absurde créée en 2025 par Angéline Delourme et Teddy Moulin.{% endblock %}">
        {% block robots %}{% endblock %}
        {# Absolute URLs built from the current domain: they follow the site when it moves to its final domain. #}
        {% if app.current_route %}
            {% set page_url = url(app.current_route, app.current_route_parameters) %}
            <link rel="canonical" href="{{ page_url }}">
            <meta property="og:url" content="{{ page_url }}">
        {% endif %}
        {# Preview when a link is shared (Facebook, WhatsApp, LinkedIn…): same title and description as the page. #}
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Fatale Destinée Production">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="{{ block('description') }}">
        {# JPEG 1200×630, the size and format every network displays (WebP is ignored by some). #}
        <meta property="og:image" content="{{ absolute_url(asset('images/og-fatale-destinee.jpg')) }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="Logo de Fatale Destinée Production">
        <meta name="twitter:card" content="summary_large_image">
        {# Fonts of the text and of the menu, needed on every page: fetched with the CSS instead of after it. #}
        <link rel="preload" href="{{ asset('fonts/lora-latin-400-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ asset('fonts/oswald-latin-700-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.scss') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {# First thing reached with Tab: jumps over the logo and the menu. #}
        <a class="skip-link" href="#contenu" data-menu-inert>Aller au contenu</a>
        <twig:FeltBorder />
        {% block layout %}
            <div class="page {% block page_class %}{% endblock %}">
                <twig:SiteMenu />
                <main id="contenu" class="page-content" tabindex="-1" data-menu-inert>
                    <twig:FlashMessages />
                    {% block body %}{% endblock %}
                </main>
                <twig:SiteFooter data-menu-inert />
            </div>
        {% endblock %}
    </body>
</html>
