{% extends 'base.html.twig' %}

{% set links = [
    {route: 'app_company', label: 'Compagnie'},
    {route: 'app_shows', label: 'Spectacles'},
    {route: 'app_agenda', label: 'Agenda'},
    {route: 'app_workshops', label: 'Ateliers'},
] %}

{% block layout %}
    <div class="home">
        <img src="{{ asset('images/teddy.png') }}" class="home-figure home-figure--left" width="300" alt="image Teddy">
        <img src="{{ asset('images/angeline.png') }}" class="home-figure home-figure--right" height="300" alt="image Angeline">

        <main class="home-center">
            <twig:FlashMessages />
            <h1 class="home-logo">
                <button type="button" class="home-logo-button"
                    data-controller="logo-sound"
                    data-action="logo-sound#play"
                    data-logo-sound-phrases-value="{{ ['Aïe !', 'Touche pas à mon chapeau !', 'Ouille !', 'Hé ho, doucement !']|json_encode }}"
                >
                    <img src="{{ asset('images/logo-fdp.webp') }}" alt="Fatale Destinée Production" width="1024" height="1024">
                </button>
            </h1>

            <nav class="home-nav" aria-label="Menu principal">
                {% for link in links %}
                    <a href="{{ path(link.route) }}">{{ link.label }}</a>
                {% endfor %}
            </nav>
        </main>
    </div>
{% endblock %}
