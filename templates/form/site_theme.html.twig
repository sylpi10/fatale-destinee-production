{# Markup of the site forms: one .input-wrapper per field, errors under the field. #}
{% use 'form_div_layout.html.twig' %}

{% block form_row %}
    {% set row_attr = row_attr|merge({class: ('input-wrapper ' ~ (row_attr.class ?? ''))|trim}) %}
    <div{% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block form_errors %}
    {% for error in errors %}
        <p class="form-error">{{ error.message }}</p>
    {% endfor %}
{% endblock %}
