{% extends 'base.html.twig' %}

{% set gallery_title = 'Photos de spectacle' %}

{% block title %}Photos – {{ parent() }}{% endblock %}

{% block body %}
    <twig:PageHeader title="Photos" :subtitle="gallery_title" />

    <div class="page-body page-body--wide"
        data-controller="lightbox"
        data-action="keydown@document->lightbox#keydown turbo:before-cache@document->lightbox#close"
    >
        <p class="gallery-caption">Photos de spectacle 2025 / Cabaret d'Hanokh Levin / représentation au théâtre de la Chocolaterie / Crédits : Elon Cattan</p>
        <ul class="gallery">
            {% for photo in photos %}
                <li>
                    <button type="button" data-action="lightbox#open" data-lightbox-index-param="{{ loop.index0 }}">
                        <img src="{{ asset(photo) }}" alt="{{ gallery_title }} – photo {{ loop.index }}" loading="lazy" data-lightbox-target="thumb">
                    </button>
                </li>
            {% endfor %}
        </ul>

        <div class="lightbox" role="dialog" aria-modal="true" hidden
            data-lightbox-target="dialog" data-action="click->lightbox#close:self"
        >
            <img src="" alt="" data-lightbox-target="image">
            <button type="button" class="lightbox-close" aria-label="Fermer" data-lightbox-target="closeButton" data-action="lightbox#close">×</button>
            <button type="button" class="lightbox-prev" aria-label="Photo précédente" data-action="lightbox#previous">‹</button>
            <button type="button" class="lightbox-next" aria-label="Photo suivante" data-action="lightbox#next">›</button>
        </div>
    </div>
{% endblock %}
