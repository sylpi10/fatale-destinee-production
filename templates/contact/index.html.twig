{% extends 'base.html.twig' %}

{% block title %}Contact – {{ parent() }}{% endblock %}

{% block body %}
    <twig:PageTitle title="Contact" />

    <div class="show-columns">
        <aside>
            <h2 class="label frame frame--ink">Teddy Moulin</h2>
            <p>
                <a href="tel:+33686554086">+33 6 86 55 40 86</a><br>
                <a href="mailto:{{ contact_email }}">{{ contact_email }}</a>
            </p>
        </aside>

        {{ form_start(form, {attr: {class: 'site-form'}}) }}
            {{ form_widget(form) }}
            <button type="submit" class="button">Envoyer</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
