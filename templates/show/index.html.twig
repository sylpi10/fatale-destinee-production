{% extends 'base.html.twig' %}

{% block title %}Spectacles – {{ parent() }}{% endblock %}

{% block body %}
    <twig:PageTitle title="Spectacles" />

    <div class="shows">
        {% for show in shows %}
            <a class="show-card" href="{{ path('app_show', {slug: show.slug}) }}">
                {% if show.image %}
                    <img src="{{ asset('uploads/spectacles/' ~ show.image) }}" alt="" width="1600" height="1200">
                {% endif %}
                <h2>{{ show.title }}</h2>
                <p>{{ [show.author, show.genre, show.creationYear ? 'Création ' ~ show.creationYear]|filter(v => v)|join(' · ') }}</p>
            </a>
        {% else %}
            <p>Les spectacles arrivent bientôt.</p>
        {% endfor %}
    </div>
{% endblock %}
