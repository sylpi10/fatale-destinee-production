{% extends 'base.html.twig' %}

{% block title %}Spectacles – {{ parent() }}{% endblock %}

{% block description %}{{ shows is empty ? 'Les spectacles de clown et de théâtre de l’absurde de Fatale Destinée Production.' : ('Les spectacles de clown de Fatale Destinée Production : ' ~ shows|map(show => show.title)|join(', ') ~ '.')|excerpt }}{% endblock %}

{% block body %}
    <twig:PageTitle title="Spectacles" />

    <div class="shows">
        {% for show in shows %}
            <twig:ShowCard :show="show" />
        {% else %}
            <p>Les spectacles arrivent bientôt.</p>
        {% endfor %}
    </div>
{% endblock %}
