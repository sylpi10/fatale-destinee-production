{% extends 'base.html.twig' %}

{% block title %}{{ show.title }} – {{ parent() }}{% endblock %}

{% block page_class %}page--show{% endblock %}

{% block body %}
    {# Sketch 5: photo, back to the list, title, genre and key facts. #}
    <div class="show-banner">
        {% if show.image %}
            <img src="{{ asset('uploads/spectacles/' ~ show.image) }}" alt="" width="1600" height="1200">
        {% endif %}
        <a class="signpost" href="{{ path('app_shows') }}">Spectacles</a>
    </div>

    <div class="show-details">
    <h1 class="show-title frame">{{ show.title }}</h1>
    {% if show.genre %}
        <div><span class="show-genre frame frame--thin">{{ show.genre }}</span></div>
    {% endif %}
    {% set facts = [
        show.creationYear ? 'Création ' ~ show.creationYear,
        show.minimumAge ? 'À partir de ' ~ show.minimumAge ~ ' ans',
        show.venues,
        show.durationMinutes ? show.durationMinutes ~ ' min',
    ]|filter(fact => fact) %}
    {% if facts is not empty %}
        <ul class="show-facts">
            {% for fact in facts %}
                <li class="frame frame--thin">{{ fact }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    {# Sketch 5': catchphrase and teaser on the left, synopsis on the right. #}
    <div class="section show-columns">
        <div>
            {% if show.catchphrase %}
                <p class="catchphrase">{{ show.catchphrase }}</p>
            {% endif %}
            {% if show.teaserUrl %}
                <div class="teaser frame">
                    <iframe src="{{ show.teaserUrl }}" title="Teaser – {{ show.title }}" loading="lazy"
                        allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
                </div>
            {% endif %}
        </div>
        <div>
            {% if show.synopsisParagraphs is not empty %}
                <h2 class="sr-only">Synopsis</h2>
                {% for paragraph in show.synopsisParagraphs %}
                    <p>{{ paragraph|nl2br }}</p>
                {% endfor %}
            {% endif %}
        </div>
    </div>

    {# Sketch 5'': documents for programmers, credits, past dates, photos, partners. #}
    <div class="section show-columns">
        <div>
            {% if show.proDocuments is not empty %}
                <h2 class="label frame frame--ink">Espace pro</h2>
                <ul class="pro-links">
                    {% for label, file in show.proDocuments %}
                        <li><a href="{{ asset('uploads/spectacles/' ~ file) }}" download>{{ label }}</a></li>
                    {% endfor %}
                </ul>
            {% endif %}

            {% if show.credits is not empty %}
                <h2 class="label frame frame--ink label--spaced">Distribution</h2>
                <dl class="credits">
                    {% for credit in show.credits %}
                        <dt>{{ credit.role }}</dt><dd>{{ credit.people|nl2br }}</dd>
                    {% endfor %}
                </dl>
            {% endif %}
        </div>
        <div>
            {# Come with the agenda and the photo gallery. #}
            <h2 class="label frame frame--ink">Quelques dates jouées</h2>
            <p class="placeholder">Dates à venir</p>
            <div class="placeholder frame">Carrousel des photos du spectacle à venir</div>
        </div>
    </div>

    <section class="section">
        <h2 class="sr-only">Partenaires</h2>
        <ul class="partners">
            {% for i in 1..6 %}<li>Logo</li>{% endfor %}
        </ul>
    </section>
    </div>

{% endblock %}
