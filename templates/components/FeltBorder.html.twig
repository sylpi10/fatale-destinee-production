{# Felt-pen red line along the screen edges with a paper margin outside it, and the #felt filter used by every .frame. #}
<svg class="felt-filters" aria-hidden="true">
    <filter id="felt">
        <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" seed="7"/>
        <feDisplacementMap in="SourceGraphic" scale="5" xChannelSelector="R" yChannelSelector="G"/>
    </filter>
</svg>
<div class="felt-mat" aria-hidden="true"></div>
<div class="felt-border" aria-hidden="true"></div>
