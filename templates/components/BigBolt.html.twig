{#
    Lightning crossing the whole viewport diagonally (top right → bottom left), fixed
    behind the content. The viewBox is stretched to any screen ("none"); strokes keep
    their width (non-scaling-stroke) and the glow is a CSS drop-shadow, so neither gets
    distorted (see .page-bolt).
#}
{% set trunk = 'M1020 -20 L1004 18 L969 57 L932 77 L906 94 L878 127 L857 168 L797 183 L791 226 L728 244 L716 291 L689 339 L653 360 L641 383 L585 395 L564 430 L532 476 L513 514 L487 532 L438 567 L409 586 L385 628 L335 652 L319 677 L274 703 L258 756 L228 796 L188 796 L170 830 L136 853 L95 900 L71 941 L35 959 L10 992 L-20 1020' %}
{% set branches = [
    'M857 168 L827 195 L790 202 L752 218 L739 236 L704 263 L676 275 L641 287',
    'M585 395 L560 404 L530 416 L510 445 L484 457 L460 467 L424 480 L401 498',
    'M335 652 L352 661 L353 683 L360 700 L381 711 L388 730 L406 748 L413 765',
    'M170 830 L138 846 L117 854 L77 879 L53 904 L34 923 L3 943 L-28 951',
] %}
<svg class="page-bolt" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path class="page-bolt-glow" d="{{ trunk }}"/>
        <path class="page-bolt-core" d="{{ trunk }}"/>
        {% for d in branches %}
            <path class="page-bolt-branch" d="{{ d }}"/>
        {% endfor %}
    </g>
</svg>
