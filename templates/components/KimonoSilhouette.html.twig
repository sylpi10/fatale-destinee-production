{#
    Placeholder figure in a black kimono, in profile, facing left, hand on the sword:
    stands in for the photos of the two actors on the home page. "mirrored" turns it
    to face right; "hair" switches between a topknot and a bun with a hairpin.
#}
{% props hair = 'topknot', mirrored = false, label = null %}
<svg {{ attributes.defaults({class: 'kimono' ~ (mirrored ? ' kimono--mirrored' : '')}) }}
    viewBox="0 0 220 640"
    {% if label %}role="img" aria-label="{{ label }}"{% else %}aria-hidden="true"{% endif %}
>
    <g class="kimono-body">
        {# head, nose, neck #}
        <ellipse cx="110" cy="62" rx="26" ry="31"/>
        <path d="M86 56 L76 70 L87 74 Z"/>
        <path d="M100 86 L121 86 L123 106 L97 106 Z"/>

        {% if hair == 'bun' %}
            <circle cx="134" cy="56" r="15"/>
            <path class="kimono-detail" d="M122 34 L150 80" stroke-width="3"/>
        {% else %}
            <path d="M118 36 C126 22 140 22 146 30 C140 32 134 36 128 44 Z"/>
        {% endif %}

        {# torso, back straight, chest forward #}
        <path d="M97 102 C80 106 70 116 66 136 L62 282 L156 282 L156 150 C154 124 140 106 123 102 Z"/>

        {# hakama, flaring to the floor #}
        <path d="M60 278 L158 278 C166 400 178 500 190 604 L32 604 C42 500 52 400 60 278 Z"/>
        <path d="M32 604 L20 616 L84 618 L86 604 Z"/>
        <path d="M152 604 L152 616 L192 616 L190 604 Z"/>

        {# katana at the hip, handle forward #}
        <path d="M24 268 L212 336 L210 343 L22 275 Z"/>

        {# wide sleeve, the hand on the handle #}
        <path d="M95 118 C72 124 60 150 57 190 L52 292 L58 330 L116 330 C121 296 119 236 113 158 Z"/>
        <circle cx="50" cy="276" r="10"/>
    </g>

    {# folds, a shade lighter so the shapes read inside the silhouette #}
    <g class="kimono-detail" fill="none" stroke-width="2.5" stroke-linecap="round">
        <path d="M97 106 L118 170 L134 104"/>
        <path d="M63 268 L156 268 M60 294 L158 294"/>
        <path d="M58 330 L116 330 M95 122 C104 190 108 260 112 326"/>
        <path d="M84 300 C76 420 68 500 62 600 M112 300 L112 600 M138 300 C146 420 154 500 162 600"/>
    </g>
</svg>
